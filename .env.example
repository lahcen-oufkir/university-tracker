# University Application Tracker — environment configuration
# Copy this file to `.env` and adjust values if needed.

# The SQLite database file. Relative paths are resolved from the project root.
# By default the application uses the local file "dev.db" at the project root,
# so you usually do NOT need to set this. It is only required by the Prisma CLI
# (prisma db push, prisma generate, seed).
DATABASE_URL="file:./dev.db"
